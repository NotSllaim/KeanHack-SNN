# Local development: start MongoDB locally before starting the app.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Optional comma-separated CORS allow-list; takes precedence over CLIENT_ORIGIN.
# CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/lingo_dev
# Replace before starting. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRES_IN=7d
AI_DEBUG=false

# Optional AI: leave credentials blank for deterministic local demo responses.
# Conversation ALWAYS uses Snowflake or local fallback, regardless of AI_PROVIDER.
# Reading/verbiage: gemini selects Google; otherwise configured Snowflake wins.
AI_PROVIDER=snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_TOKEN=
SNOWFLAKE_MODEL=openai-gpt-4.1
# Historical GEMMA_ names; this example endpoint selects Gemini, not Gemma.
GEMMA_API_KEY=
GEMMA_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent
GEMMA_MODEL=gemini-2.5-flash-lite
GEMINI_THINKING_BUDGET=0

# Optional recorded-audio transcription. Blank key returns a fixed demo transcript.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL_ID=scribe_v1
# Optional ElevenLabs speech output when Deepgram is absent or fails.
ELEVENLABS_TTS_VOICE_ID=
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
# Optional speech output; otherwise the client attempts browser speech synthesis.
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL_ID=aura-2-arcas-en
DEEPGRAM_TTS_SANA_MODEL_ID=aura-2-athena-en
DEEPGRAM_TTS_THEO_MODEL_ID=aura-2-orpheus-en
DEEPGRAM_TTS_JAX_MODEL_ID=aura-2-apollo-en
DEEPGRAM_TTS_MIRA_MODEL_ID=aura-2-vesta-en

# Browser-visible values. NEVER place private credentials in VITE_* variables.
VITE_API_URL=http://localhost:5000/api

# Optional Solana DEVNET demo. Blank RPC uses public devnet; no paid RPC needed.
# Merchant wallet is a PUBLIC address. Leave blank to disable payment UI.
# Client/server wallet, mint and price must agree. UI currently displays 30 days.
VITE_HELIUS_DEVNET_RPC=
VITE_MERCHANT_WALLET=
VITE_USDC_MINT_DEVNET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
VITE_SUBSCRIPTION_PRICE_USDC=0.1
HELIUS_DEVNET_RPC=
MERCHANT_WALLET=
USDC_MINT_DEVNET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SUBSCRIPTION_PRICE_USDC=0.1
SUBSCRIPTION_DURATION_DAYS=30
